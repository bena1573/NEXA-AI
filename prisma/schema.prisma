// NEXA AI — multi-tenant AI customer support platform.
// Every business-owned model carries `businessId` and is queried only through
// lib/db/tenant.ts so one business can never read another's data.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum Channel {
  VOICE
  CHAT
  EMAIL
}

enum ConversationStatus {
  OPEN
  RESOLVED
  ESCALATED
  ABANDONED
}

enum Handler {
  AI
  HUMAN
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum MessageRole {
  CUSTOMER
  AGENT
  SYSTEM
}

enum CustomerStatus {
  NEW
  ACTIVE
  RETURNING
  VIP
  AT_RISK
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  MISSED
  TRANSFERRED
  FAILED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum DocumentType {
  TEXT
  URL
  PDF
  TXT
  DOCX
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum AgentPersonality {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  FORMAL
}

enum ResponseStyle {
  SHORT
  BALANCED
  DETAILED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EscalationReason {
  ANGRY_CUSTOMER
  REFUND_REQUEST
  LEGAL_ISSUE
  UNKNOWN_QUESTION
  HUMAN_REQUESTED
  SENSITIVE_ISSUE
  LOW_CONFIDENCE
}

enum IntegrationKind {
  TELEPHONY
  CALENDAR
  CRM
  ECOMMERCE
  EMAIL
  PAYMENT
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum Plan {
  STARTER
  BUSINESS
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum UsageMetric {
  CONVERSATIONS
  VOICE_MINUTES
  AI_TOKENS
  KNOWLEDGE_DOCUMENTS
  TEAM_MEMBERS
}

enum NotificationKind {
  ESCALATION
  APPOINTMENT
  SYSTEM
  USAGE
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String
  passwordHash  String
  emailVerified Boolean   @default(false)
  // Email verification / password reset architecture: single-use hashed tokens.
  verifyToken   String?   @unique
  resetToken    String?   @unique
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  sessions    Session[]
  tickets     SupportTicket[] @relation("TicketAssignee")

  @@index([createdAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Business {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  industry       String?
  description    String?
  website        String?
  phone          String?
  email          String?
  addressLine    String?
  city           String?
  country        String?
  timezone       String   @default("UTC")
  // Public identifier used by the embeddable widget; safe to expose.
  publicWidgetId String   @unique @default(uuid()) @db.Uuid
  demo           Boolean  @default(false)
  onboardedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships   Membership[]
  hours         BusinessHour[]
  agent         AIAgent?
  customers     Customer[]
  conversations Conversation[]
  calls         Call[]
  documents     KnowledgeDocument[]
  chunks        KnowledgeChunk[]
  faqs          FAQ[]
  services      Service[]
  appointments  Appointment[]
  tickets       SupportTicket[]
  integrations  Integration[]
  notifications Notification[]
  subscription  Subscription?
  usage         UsageRecord[]
  invites       Invite[]

  @@index([createdAt])
}

model BusinessHour {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // 0 = Sunday … 6 = Saturday
  weekday    Int
  opensAt    String?
  closesAt   String?
  closed     Boolean  @default(false)

  @@unique([businessId, weekday])
  @@index([businessId])
}

model Membership {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role     @default(OWNER)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

model Invite {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  role       Role     @default(AGENT)
  tokenHash  String   @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([businessId, email])
  @@index([businessId])
}

model AIAgent {
  id           String           @id @default(uuid()) @db.Uuid
  businessId   String           @unique @db.Uuid
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String           @default("Alex")
  personality  AgentPersonality @default(PROFESSIONAL)
  responseStyle ResponseStyle   @default(BALANCED)
  greeting     String           @default("Hi! How can I help you today?")
  instructions String           @default("")
  voiceName    String           @default("nova")
  escalationRules String        @default("")
  handoffEmail String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  businessId   String         @db.Uuid
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String?
  email        String?
  phone        String?
  status       CustomerStatus @default(NEW)
  tags         String[]       @default([])
  notes        String?
  lastSeenAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  conversations Conversation[]
  appointments  Appointment[]
  tickets       SupportTicket[]

  @@unique([businessId, email])
  @@unique([businessId, phone])
  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model Conversation {
  id          String             @id @default(uuid()) @db.Uuid
  businessId  String             @db.Uuid
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String?            @db.Uuid
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel     Channel
  status      ConversationStatus @default(OPEN)
  handler     Handler            @default(AI)
  sentiment   Sentiment?
  intent      String?
  summary     String?
  resolved    Boolean            @default(false)
  escalated   Boolean            @default(false)
  escalationReason EscalationReason?
  satisfaction Int?
  startedAt   DateTime           @default(now())
  endedAt     DateTime?
  updatedAt   DateTime           @updatedAt

  messages Message[]
  call     Call?
  tickets  SupportTicket[]

  @@index([businessId, startedAt])
  @@index([businessId, channel])
  @@index([businessId, status])
  @@index([customerId])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // Tool calls made while producing this message, and knowledge chunk ids used.
  toolCalls      Json?
  citedChunkIds  String[]    @default([])
  confidence     Float?
  latencyMs      Int?
  createdAt      DateTime    @default(now())

  @@index([conversationId, createdAt])
}

model Call {
  id             String        @id @default(uuid()) @db.Uuid
  businessId     String        @db.Uuid
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String        @unique @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      CallDirection @default(INBOUND)
  status         CallStatus    @default(RINGING)
  fromNumber     String?
  toNumber       String?
  // Provider that handled the call; "simulator" for demo calls.
  provider       String        @default("simulator")
  providerCallId String?
  simulated      Boolean       @default(true)
  durationSec    Int           @default(0)
  recordingUrl   String?
  transferredTo  String?
  startedAt      DateTime      @default(now())
  endedAt        DateTime?

  @@index([businessId, startedAt])
  @@index([businessId, status])
}

model KnowledgeDocument {
  id         String         @id @default(uuid()) @db.Uuid
  businessId String         @db.Uuid
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  type       DocumentType
  status     DocumentStatus @default(PENDING)
  sourceUrl  String?
  fileName   String?
  content    String?
  error      String?
  chunkCount Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  chunks KnowledgeChunk[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

model KnowledgeChunk {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @db.Uuid
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documentId String            @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position   Int
  content    String
  tokens     Int               @default(0)
  // pgvector column; Prisma cannot type it, so reads/writes use raw SQL.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime          @default(now())

  @@index([businessId])
  @@index([documentId, position])
}

model FAQ {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  approved   Boolean  @default(true)
  askedCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, approved])
}

model Service {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @db.Uuid
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  durationMin  Int      @default(30)
  priceCents   Int?
  currency     String   @default("USD")
  bookable     Boolean  @default(true)
  staffName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]

  @@unique([businessId, name])
  @@index([businessId, bookable])
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @db.Uuid
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String            @db.Uuid
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String            @db.Uuid
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  status      AppointmentStatus @default(REQUESTED)
  startsAt    DateTime
  endsAt      DateTime
  notes       String?
  bookedByAI  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([businessId, startsAt])
  @@index([customerId])
  @@index([serviceId, startsAt])
}

model SupportTicket {
  id             String           @id @default(uuid()) @db.Uuid
  businessId     String           @db.Uuid
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId String?          @db.Uuid
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId     String?          @db.Uuid
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assigneeId     String?          @db.Uuid
  assignee       User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  subject        String
  body           String
  status         TicketStatus     @default(OPEN)
  priority       TicketPriority   @default(NORMAL)
  reason         EscalationReason?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([businessId, status])
  @@index([conversationId])
}

model Integration {
  id         String            @id @default(uuid()) @db.Uuid
  businessId String            @db.Uuid
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       IntegrationKind
  provider   String
  status     IntegrationStatus @default(DISCONNECTED)
  // Non-secret configuration only; credentials live in env / a secret manager.
  config     Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([businessId, provider])
  @@index([businessId, kind])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @db.Uuid
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       NotificationKind
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([businessId, createdAt])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  businessId         String             @unique @db.Uuid
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan               Plan               @default(STARTER)
  status             SubscriptionStatus @default(TRIALING)
  // Populated only when a real payment provider is connected.
  providerCustomerId String?
  providerSubId      String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model UsageRecord {
  id         String      @id @default(uuid()) @db.Uuid
  businessId String      @db.Uuid
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  metric     UsageMetric
  quantity   Int
  // First day of the billing month this record belongs to.
  period     DateTime
  createdAt  DateTime    @default(now())

  @@index([businessId, metric, period])
}
